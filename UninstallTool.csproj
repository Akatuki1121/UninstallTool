<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="Core\UninstallTool.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI(WPF)とCoreは別プロジェクトなので、このコンソールプロジェクトのビルド対象から除外する -->
    <Compile Remove="UI\**" />
    <Compile Remove="Core\**" />
    <EmbeddedResource Remove="UI\**" />
    <EmbeddedResource Remove="Core\**" />
    <None Remove="UI\**" />
    <None Remove="Core\**" />
  </ItemGroup>

</Project>
